# Copy to .env.enterprise and fill real values. Never commit the filled file.
POSTGRES_DB=terrafield
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-password

NEXTAUTH_SECRET=replace-with-32-byte-random-secret
NEXTAUTH_URL=https://terrafieldatlas.us
NEXT_PUBLIC_SITE_URL=https://terrafieldatlas.us
DOMAIN=terrafieldatlas.us
ACME_EMAIL=ops@example.org

GRAFANA_ADMIN_PASSWORD=replace-with-strong-password

# Generate with: openssl rand -base64 32
WEBHOOK_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Optional; defaults to the verified NASA MAAP public STAC API.
STAC_API_URL=https://stac.maap-project.org/search

IMAGE_TAG=latest
HTTP_PORT=80
HTTPS_PORT=443
