{
  "uid": "terrafield-overview",
  "title": "TerraField Atlas Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Database",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }, { "color": "green", "value": 1 }] } } },
      "targets": [{ "expr": "min(terrafield_database_up)", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Redis",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }, { "color": "green", "value": 1 }] } } },
      "targets": [{ "expr": "min(terrafield_redis_up)", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Queue waiting",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [{ "expr": "sum(terrafield_queue_waiting)", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Oldest job age (s)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "expr": "max(terrafield_queue_oldest_job_age_seconds)", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP requests by status",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (status) (rate(terrafield_http_requests_total[5m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Request duration p95 proxy (sum/count)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum(rate(terrafield_http_request_duration_ms_sum[5m])) / clamp_min(sum(rate(terrafield_http_request_duration_ms_count[5m])), 0.001)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Scheduler leader",
      "gridPos": { "x": 0, "y": 12, "w": 6, "h": 4 },
      "targets": [{ "expr": "max(terrafield_scheduler_leader)", "refId": "A" }]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Worker heartbeats",
      "gridPos": { "x": 6, "y": 12, "w": 6, "h": 4 },
      "targets": [{ "expr": "max(terrafield_queue_workers)", "refId": "A" }]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "SSE subscribers",
      "gridPos": { "x": 12, "y": 12, "w": 6, "h": 4 },
      "targets": [{ "expr": "sum(terrafield_sse_subscribers)", "refId": "A" }]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Dead-lettered jobs",
      "gridPos": { "x": 18, "y": 12, "w": 6, "h": 4 },
      "targets": [{ "expr": "sum(terrafield_jobs_dead_lettered)", "refId": "A" }]
    }
  ]
}
